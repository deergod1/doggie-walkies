# Before writing or changing music, read music/README.md (style, moods, format).
# Not a song: a jingle, played once as a sound (like music/jingles/victory.scrim).
# Played by audio/jingles.js: game/quests.js, when its reward is paid.
title    Quest
composer Claude
about    A villager thanked: the warmest of the jingles, the toy tune as a little waltz in F major on a music box (F G A, C Bb, A) with a crystal echo and a fretless bass, ending on the bird's wide call.
tempo    144
beats    3
steps    4
reverb   0.45

# mood explore: lead echo bird bass

voice lead      musicbox   vol=0.5  pan=-0.1 rev=0.5
voice echo      crystal    vol=0.26 pan=0.4  rev=0.65
voice bird      crystal    vol=0.5  pan=0.35 rev=0.75
voice bass      fretless   vol=0.6

# F | Bb C | F
pattern thanks
lead      | F5--- G5- A5----- | C6----- Bb5----- | A5----------- |
echo      | . F6--- G6- A6---- | - C7----- Bb6---- | - A6---------- |
bird      | _ | _ | .----- C7 F6+G6---- |
bass      | F2----------- | Bb1----- C2----- | F1----------- |

loop thanks
